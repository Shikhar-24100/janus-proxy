# Allow only build inputs. Credentials, local tools, Git and output never enter
# the Docker build context, even when someone adds another private file.
*
!Dockerfile
!go.mod
!go.sum
!auth.go
!admission.go
!admission_test.go
!auth_test.go
!breaker.go
!breaker_test.go
!cache.go
!cache_test.go
!chat.go
!chat_test.go
!latency.go
!main.go
!performance_test.go
!provider.go
!provider_test.go
!quota.go
!quota_test.go
!rate_limit.go
!rate_limit_test.go
!router.go
!router_live_test.go
!router_test.go
!stream.go
!stream_test.go
!telemetry.go
!telemetry_test.go
!tenants.go
!tenants_test.go
!tokens.go
!tokens_test.go
!usage_queue.go
!usage_store.go
!usage_test.go
!outbox.go
!outbox_linux.go
!outbox_other.go
!outbox_test.go
!migrations/
!migrations/**
!queries/
!queries/**
!cmd/
!cmd/loadtest/
!cmd/loadtest/main.go
!cmd/loadtest/main_test.go

# Prune large local directories without traversing their nested Go files.
.cache/
.tools/
.git/
.container/
.janus-outbox/
output/
tmp/
.env*
