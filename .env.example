# Copy this file to .env and replace the placeholder with your provider key.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your-groq-key
JANUS_API_KEY=your-own-janus-client-key
LISTEN_ADDR=127.0.0.1:8080
MAX_INFLIGHT=32
REDIS_URL=redis://127.0.0.1:6380/0
RPM_LIMIT=60
TPM_LIMIT=60000
MAX_OUTPUT_TOKENS=1024
CACHE_TTL_SECONDS=300

# Optional durable usage storage. Set both to enable; keep both empty to disable.
DATABASE_URL=
USAGE_REDIS_URL=
# Linux durable outbox: leave empty to disable, or use .janus-outbox.
USAGE_OUTBOX_DIR=
USAGE_OUTBOX_MAX_MB=32

# Optional tenant config; empty keeps JANUS_API_KEY as the default chat tenant.
TENANTS_CONFIG=
# Tenant key environment variable names must end in _JANUS_API_KEY for run.ps1.
# ALICE_JANUS_API_KEY=replace-with-a-unique-client-key
# BOB_JANUS_API_KEY=replace-with-a-different-client-key

# Optional fallback. Leave the key empty to disable it.
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=gpt-4o-mini
