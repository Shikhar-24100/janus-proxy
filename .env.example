# Copy this file to .env and replace the placeholder with your provider key.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your-groq-key
JANUS_API_KEY=your-own-janus-client-key
REDIS_URL=redis://127.0.0.1:6380/0
RPM_LIMIT=60
TPM_LIMIT=60000
MAX_OUTPUT_TOKENS=1024

# Optional fallback. Leave the key empty to disable it.
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=gpt-4o-mini
